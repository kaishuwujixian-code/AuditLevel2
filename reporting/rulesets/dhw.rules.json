              },
              "then": {
                "paragraphs": [
                  "The boilers and DHW storage tanks were observed to be original to the building.",
                  "The equipment is approaching the end of its expected service life.",
                  "Replacement planning should be considered."
                ]
              }
            },
            {
              "rule_id": "dhw_storage_temperature_variation",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_storage_temp_variation_observed",
                    "op": "is_true"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "DHW storage temperatures varied across the building.",
