{
  "rulesets": [
    {
      "ruleset_version": "1.0",
      "ruleset_name": "DHW SYSTEM RULESET – CENTRAL DHW BOILERS",
      "blocks": [
        {
          "block_id": "dhw_existing",
          "block_ref": "{DHW System Block}",
          "target_block": "dhw",
          "rules": [
            {
              "rule_id": "dhw_central_intro",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_generation_type",
                    "op": "eq",
                    "value": "central_dhw_boilers"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Domestic hot water (DHW) is generated in the central mechanical room."
                ]
              },
              "role": "system_header",
              "exclusive_group": "dhw_central_boiler_header",
              "priority": 10
            },
            {
              "rule_id": "dhw_boiler_count_capacity",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_generation_type",
                    "op": "eq",
                    "value": "central_dhw_boilers"
                  },
                  {
                    "field": "answers.number_of_dhw_boilers",
                    "op": "exists"
                  },
                  {
                    "field": "answers.dhw_boiler_capacity_mbh",
                    "op": "exists"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "The DHW plant consists of {number_of_dhw_boilers} DHW boilers.",
                  "Each boiler is rated at approximately {dhw_boiler_capacity_mbh} MBH."
                ]
              },
              "role": "equipment_detail"
            },
            {
              "rule_id": "dhw_boiler_type_atmospheric",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_generation_type",
                    "op": "eq",
                    "value": "central_dhw_boilers"
                  },
                  {
                    "field": "answers.dhw_boiler_type",
                    "op": "eq",
                    "value": "atmospheric"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "The DHW system consists of atmospheric gas-fired DHW boilers."
                ]
              },
              "role": "equipment_detail"
            },
            {
              "rule_id": "dhw_boiler_type_non_condensing",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_generation_type",
                    "op": "eq",
                    "value": "central_dhw_boilers"
                  },
                  {
                    "field": "answers.dhw_boiler_type",
                    "op": "eq",
                    "value": "non_condensing"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "The DHW plant consists of non-condensing DHW boilers."
                ]
              },
              "role": "equipment_detail"
            },
            {
              "rule_id": "dhw_boiler_install_year",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_generation_type",
                    "op": "eq",
                    "value": "central_dhw_boilers"
                  },
                  {
                    "field": "answers.dhw_boiler_install_year",
                    "op": "exists"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "The DHW boilers were installed in {dhw_boiler_install_year}."
                ]
              },
              "role": "equipment_detail"
            },
            {
              "rule_id": "dhw_supply_temperature",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_generation_type",
                    "op": "eq",
                    "value": "central_dhw_boilers"
                  },
                  {
                    "field": "answers.dhw_supply_temp_f",
                    "op": "exists"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "The boilers operate with a DHW supply temperature of approximately {dhw_supply_temp_f}°F."
                ]
              },
              "role": "performance"
            },
            {
              "rule_id": "dhw_mixing_valve_mechanical",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_generation_type",
                    "op": "eq",
                    "value": "central_dhw_boilers"
                  },
                  {
                    "field": "answers.dhw_mixing_valve_type",
                    "op": "eq",
                    "value": "mechanical"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Mixed-water temperature control is provided through mechanical thermostatic valves.",
                  "These valves regulate delivery temperature to the building."
                ]
              },
              "role": "equipment_detail"
            },
            {
              "rule_id": "dhw_mixing_valve_flowmix",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_generation_type",
                    "op": "eq",
                    "value": "central_dhw_boilers"
                  },
                  {
                    "field": "answers.dhw_mixing_valve_type",
                    "op": "eq",
                    "value": "flowmix_electronic"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Mixed-water temperature control is provided through a FlowMix electronic thermostatic mixing valve.",
                  "The valve regulates DHW delivery temperature to the building."
                ]
              },
              "role": "equipment_detail"
            },
            {
              "rule_id": "dhw_piping_condition_good",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_generation_type",
                    "op": "eq",
                    "value": "central_dhw_boilers"
                  },
                  {
                    "field": "answers.dhw_piping_condition",
                    "op": "eq",
                    "value": "good"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "The boilers, storage tanks, and associated piping appear to be in generally good condition.",
                  "No visible leaks or major signs of corrosion were observed."
                ]
              },
              "role": "condition"
            },
            {
              "rule_id": "dhw_recirculation_pumps_operating",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_generation_type",
                    "op": "eq",
                    "value": "central_dhw_boilers"
                  },
                  {
                    "field": "answers.dhw_recirculation_pumps_operating",
                    "op": "is_true"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "DHW recirculation pumps were operating at the time of the site visit."
                ]
              },
              "role": "performance"
            },
            {
              "rule_id": "dhw_storage_temperature_variation",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_generation_type",
                    "op": "eq",
                    "value": "central_dhw_boilers"
                  },
                  {
                    "field": "answers.dhw_storage_temp_variation_observed",
                    "op": "is_true"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "DHW storage temperatures varied across the building.",
                  "Some zones were operating below recommended storage temperature ranges."
                ]
              },
              "role": "performance"
            },
            {
              "rule_id": "dhw_storage_tank_gauge_failed",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_generation_type",
                    "op": "eq",
                    "value": "central_dhw_boilers"
                  },
                  {
                    "field": "answers.dhw_storage_temp_gauge_functional",
                    "op": "is_false"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "The temperature gauge on the DHW storage tank was not functioning.",
                  "Recalibration or replacement is required to ensure accurate temperature monitoring."
                ]
              },
              "role": "finding"
            },
            {
              "rule_id": "dhw_end_of_life",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_generation_type",
                    "op": "eq",
                    "value": "central_dhw_boilers"
                  },
                  {
                    "field": "answers.dhw_boilers_original",
                    "op": "is_true"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "The boilers and DHW storage tanks were observed to be original to the building.",
                  "The equipment is approaching the end of its expected service life.",
                  "Replacement planning should be considered."
                ]
              },
              "role": "finding"
            },
            {
              "rule_id": "dhw_no_mixing_valves",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_generation_type",
                    "op": "eq",
                    "value": "central_dhw_boilers"
                  },
                  {
                    "field": "answers.dhw_mixing_valve_present",
                    "op": "is_false"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Anti-scald mixing valves were not observed at the domestic hot water system.",
                  "Without properly installed and commissioned mixing valves, there is an increased risk of scalding and elevated recirculation temperatures.",
                  "This can increase natural gas consumption."
                ]
              },
              "role": "finding"
            },
            {
              "rule_id": "dhw_system_functional",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_generation_type",
                    "op": "in",
                    "value": [
                      "central_dhw_boilers",
                      "boiler_fed_via_hx"
                    ]
                  },
                  {
                    "field": "answers.dhw_functional",
                    "op": "is_true"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Overall, the DHW system appears to be functioning adequately."
                ]
              },
              "role": "performance"
            },
            {
              "rule_id": "dhw_control_adjustments_recommended",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_generation_type",
                    "op": "in",
                    "value": [
                      "central_dhw_boilers",
                      "boiler_fed_via_hx"
                    ]
                  },
                  {
                    "field": "answers.dhw_functional",
                    "op": "is_true"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Targeted control adjustments, valve inspection, or replacement may be warranted where temperature control is not performing as intended."
                ]
              },
              "role": "finding"
            },
            {
              "rule_id": "dhw_replacement_planning",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_generation_type",
                    "op": "eq",
                    "value": "central_dhw_boilers"
                  },
                  {
                    "field": "answers.dhw_replacement_planning_recommended",
                    "op": "is_true"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Due to the age of the equipment and the inherent efficiency limitations of atmospheric boilers, replacement planning is recommended to improve reliability, efficiency, and long-term maintainability."
                ]
              },
              "role": "finding"
            }
          ],
          "target_section": "dhw"
        }
      ]
    },
    {
      "ruleset_version": "1.0",
      "ruleset_name": "DHW SYSTEM RULESET – BOILER-FED VIA HEAT EXCHANGER",
      "blocks": [
        {
          "block_id": "dhw_existing",
          "block_ref": "{DHW System Block}",
          "target_block": "dhw",
          "rules": [
            {
              "rule_id": "dhw_intro_hx",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_generation_type",
                    "op": "eq",
                    "value": "boiler_fed_via_hx"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Domestic hot water is produced in the central mechanical room.",
                  "The DHW loop receives heat from the boiler plant through a heat exchanger."
                ]
              },
              "role": "system_header",
              "exclusive_group": "dhw_hx_header",
              "priority": 20
            },
            {
              "rule_id": "dhw_flowmix_present",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_generation_type",
                    "op": "eq",
                    "value": "boiler_fed_via_hx"
                  },
                  {
                    "field": "answers.dhw_mixing_valve_type",
                    "op": "eq",
                    "value": "flowmix_electronic"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "A FlowMix electronic mixing valve is used to regulate domestic hot water delivery temperature."
                ]
              },
              "role": "equipment_detail"
            },
            {
              "rule_id": "dhw_temperatures_normal",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_generation_type",
                    "op": "eq",
                    "value": "boiler_fed_via_hx"
                  },
                  {
                    "field": "answers.dhw_storage_temp_f",
                    "op": "exists"
                  },
                  {
                    "field": "answers.dhw_mixed_temp_f",
                    "op": "exists"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Observed DHW temperatures were within normal operating range.",
                  "The storage tank temperature was approximately {dhw_storage_temp_f}°F.",
                  "The mixed water temperature was approximately {dhw_mixed_temp_f}°F."
                ]
              },
              "role": "performance"
            },
            {
              "rule_id": "dhw_equipment_condition_good",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_generation_type",
                    "op": "eq",
                    "value": "boiler_fed_via_hx"
                  },
                  {
                    "field": "answers.dhw_equipment_condition",
                    "op": "eq",
                    "value": "good"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "The DHW storage tank, buffer tanks, and associated piping were observed to be in generally good condition.",
                  "No visible leaks or signs of corrosion were observed."
                ]
              },
              "role": "condition"
            },
            {
              "rule_id": "dhw_recirculation_pumps_operating_hx",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_generation_type",
                    "op": "eq",
                    "value": "boiler_fed_via_hx"
                  },
                  {
                    "field": "answers.dhw_recirculation_pumps_operating",
                    "op": "is_true"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "DHW recirculation pumps were operating during the site visit."
                ]
              },
              "role": "performance"
            },
            {
              "rule_id": "dhw_future_bas_ready",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_generation_type",
                    "op": "eq",
                    "value": "boiler_fed_via_hx"
                  },
                  {
                    "field": "answers.bas_future_integration_feasible",
                    "op": "is_true"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "The system is suitably configured for future BAS integration to improve monitoring and temperature optimization."
                ]
              },
              "role": "finding"
            }
          ],
          "target_section": "dhw"
        }
      ]
    }
  ]
}
