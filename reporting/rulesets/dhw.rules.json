                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "A FlowMix electronic mixing valve is used to regulate domestic hot water delivery temperature."
                ]
              }
            },
            {
              "rule_id": "dhw_temperatures_normal",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_storage_temp_f",
                    "op": "exists"
                  },
                  {
                    "field": "answers.dhw_mixed_temp_f",
                    "op": "exists"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Observed DHW temperatures were within normal operating range.",
                  "The storage tank temperature was approximately {dhw_storage_temp_f}°F.",
                  "The mixed water temperature was approximately {dhw_mixed_temp_f}°F."
                ]
              }
            },
            {
              "rule_id": "dhw_equipment_condition_good",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_equipment_condition",
                    "op": "eq",
                    "value": "good"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "The DHW storage tank, buffer tanks, and associated piping were observed to be in generally good condition.",
                  "No visible leaks or signs of corrosion were observed."
                ]
              }
            },
            {
              "rule_id": "dhw_pumps_insulation_ok",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_recirculation_pumps_operating",
                    "op": "is_true"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "DHW recirculation pumps were operating during the site visit.",
