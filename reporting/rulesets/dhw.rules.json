                    "field": "answers.dhw_mixing_valve_present",
                    "op": "is_false"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Anti-scald mixing valves were not observed at the domestic hot water system.",
                  "Without properly installed and commissioned mixing valves, there is an increased risk of scalding and elevated recirculation temperatures.",
                  "This can increase natural gas consumption."
                ]
              }
            },
            {
              "rule_id": "dhw_system_overall_condition",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_functional",
                    "op": "is_true"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Overall, the DHW system appears to be functioning adequately.",
                  "Targeted control adjustments, valve inspection, or replacement may be warranted where temperature control is not performing as intended."
                ]
              }
            }
          ],
          "target_section": "dhw"
        }
      ]
    },
    {
      "ruleset_version": "1.0",
      "ruleset_name": "DHW SYSTEM RULESET – BOILER-FED DHW WITH HEAT EXCHANGER AND FLOWMIX",
      "blocks": [
        {
          "block_id": "dhw_existing",
          "block_ref": "{DHW System Block}",
          "target_block": "dhw",
          "rules": [
            {
              "rule_id": "dhw_intro_hx",
              "if": {
                "all": [
                  {
                    "field": "answers.dhw_generation_type",
                    "op": "eq",
                    "value": "boiler_fed_via_hx"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Domestic hot water is produced in the central mechanical room.",
                  "The DHW loop receives heat from the boiler plant through a heat exchanger."
                ]
              },
              "role": "system_header",
              "exclusive_group": "dhw_system_header",
              "priority": 40
            },
            {
              "rule_id": "dhw_flowmix_present",
