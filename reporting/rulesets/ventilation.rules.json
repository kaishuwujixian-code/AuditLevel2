    {
      "ruleset_version": "1.0",
      "ruleset_name": "VENTILATION SYSTEM RULESET \u2013 DOAS / AHU",
      "blocks": [
        {
          "block_id": "central_ventilation_existing",
          "block_ref": "{Central Ventilation System Block}",
          "target_block": "ventilation",
          "rules": [
            {
              "rule_id": "ventilation_doas_intro",
              "if": {
                "all": [
                  {
                    "field": "answers.ventilation_system_type",
                    "op": "eq",
                    "value": "doas"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Ventilation for the building is provided by a dedicated outdoor air system (DOAS) or air handling unit (AHU)."
                ]
              },
              "role": "system_header",
              "exclusive_group": "ventilation_system_header",
              "priority": 40
            },
            {
              "rule_id": "ventilation_airflow_summary",
              "if": {
                "all": [
                  {
                    "field": "answers.ventilation_airflow_cfm",
                    "op": "exists"
                  },
                  {
                    "field": "answers.ventilation_system_type",
                    "op": "eq",
                    "value": "doas"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "The ventilation system is designed to deliver approximately {ventilation_airflow_cfm} CFM of outdoor air."
                ]
              },
              "role": "equipment_detail"
            },
            {
              "rule_id": "ventilation_system_mechanical_condition",
              "then": {
                "paragraphs": [
                  "The existing central ventilation equipment was observed to be in {ventilation_system_condition_text} condition."
                ]
              },
              "role": "equipment_detail",
              "priority": 1
            }
          ],
          "target_section": "ventilation"
        }
      ]
    }
  ]
