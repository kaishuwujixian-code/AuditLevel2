{
  "rulesets": [
    {
      "ruleset_version": "1.0",
      "ruleset_name": "VENTILATION SYSTEM RULESET \u2013 EXHAUST ONLY / UNKNOWN SUPPLY",
      "blocks": [
        {
          "block_id": "central_ventilation_existing",
          "block_ref": "{Central Ventilation System Block}",
          "target_block": "ventilation",
          "rules": [
            {
              "rule_id": "suite_exhaust_systems",
              "if": {
                "all": [
                  {
                    "field": "answers.ventilation_system_type",
                    "op": "in",
                    "value": [
                      "suite_exhaust_only",
                      "exhaust_only"
                    ]
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Ventilation for the building is provided through exhaust fan systems, including kitchen, dryer, and bathroom exhaust systems serving individual suites.",
                  "Based on interior observations, these exhaust systems appear to operate as independent, direct exhaust systems."
                ]
              },
              "role": "system_header",
              "exclusive_group": "ventilation_system_header",
              "priority": 10
            },
            {
              "rule_id": "no_rooftop_access",
              "if": {
                "all": [
                  {
                    "field": "answers.rooftop_access_available",
                    "op": "is_false"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Access to rooftop mechanical equipment was not available at the time of the site visit.",
                  "The presence and configuration of make-up air (MUA) units or air handling units (AHUs) could not be confirmed."
                ]
              },
              "role": "equipment_detail"
            },
            {
              "rule_id": "no_heat_recovery_observed",
              "if": {
                "all": [
                  {
                    "field": "answers.heat_recovery_observed",
                    "op": "is_false"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "No evidence of heat recovery associated with these exhaust systems was observed from accessible areas."
                ]
              },
              "role": "equipment_detail"
            },
            {
              "rule_id": "erv_hrv_uncertain",
              "if": {
                "all": [
                  {
                    "field": "answers.erv_hrv_present",
                    "op": "unknown"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "The presence of in-suite energy recovery ventilators (ERVs) or heat recovery ventilators (HRVs) could not be confirmed during the walkthrough."
                ]
              },
              "role": "equipment_detail"
            },
            {
              "rule_id": "ventilation_system_mechanical_condition",
              "then": {
                "paragraphs": [
                  "The existing central ventilation equipment was observed to be in {ventilation_system_condition_text} condition."
                ]
              },
              "role": "equipment_detail",
              "priority": 1
            }
          ],
          "target_section": "ventilation"
        }
      ]
    },
    {
      "ruleset_version": "1.0",
      "ruleset_name": "VENTILATION SYSTEM RULESET \u2013 ROOFTOP MUA WITH GAS HEAT AND DX COOLING",
      "blocks": [
        {
          "block_id": "central_ventilation_existing",
          "block_ref": "{Central Ventilation System Block}",
          "target_block": "ventilation",
          "rules": [
            {
              "rule_id": "ventilation_mua_intro",
              "if": {
                "all": [
                  {
                    "field": "answers.ventilation_system_type",
                    "op": "in",
                    "value": [
                      "mua_gas_rooftop",
                      "mua_hydronic_coil",
                      "mua_corridor"
                    ]
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Ventilation for the building is provided by rooftop make-up air (MUA) units serving corridors and other shared common areas."
                ]
              },
              "role": "system_header",
              "exclusive_group": "ventilation_system_header",
              "priority": 20
            },
            {
              "rule_id": "mua_count",
              "if": {
                "all": [
                  {
                    "field": "answers.mua_count",
                    "op": "exists"
                  },
                  {
                    "field": "answers.ventilation_system_type",
                    "op": "in",
                    "value": [
                      "mua_gas_rooftop",
                      "mua_hydronic_coil",
                      "mua_corridor"
                    ]
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "The building is equipped with {mua_count} rooftop MUA units."
                ]
              },
              "role": "equipment_detail"
            },
            {
              "rule_id": "mua_equipment_configuration",
              "if": {
                "all": [
                  {
                    "field": "answers.mua_has_gas_heat",
                    "op": "is_true"
                  },
                  {
                    "field": "answers.mua_has_dx_cooling",
                    "op": "is_true"
                  },
                  {
                    "field": "answers.ventilation_system_type",
                    "op": "in",
                    "value": [
                      "mua_gas_rooftop",
                      "mua_hydronic_coil",
                      "mua_corridor"
                    ]
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "The MUA units are equipped with supply fans with variable frequency drives (VFDs), integral gas-fired heating burners, and DX cooling sections."
                ]
              },
              "role": "equipment_detail"
            },
            {
              "rule_id": "ventilation_system_mechanical_condition",
              "then": {
                "paragraphs": [
                  "The existing central ventilation equipment was observed to be in {ventilation_system_condition_text} condition."
                ]
              },
              "role": "equipment_detail",
              "priority": 1
            }
          ],
          "target_section": "ventilation"
        }
      ]
    },
    {
