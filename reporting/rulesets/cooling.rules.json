      "blocks": [
        {
          "block_id": "central_cooling_existing",
          "block_ref": "{Central Cooling Systems block}",
          "target_block": "cooling",
          "rules": [
            {
              "rule_id": "cooling_magic_pak_unit",
              "if": {
                "any": [
                  {
                    "field": "answers.cooling_system_type",
                    "op": "eq",
                    "value": "in_suite_magic_pak_unit"
                  },
                  {
                    "field": "answers.suite_cooling_type",
                    "op": "eq",
                    "value": "magic_pak_unit"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Each suite is equipped with a Magic-Pak unit installed within a dedicated mechanical closet. The Magic-Pak unit consists of a gas-fired furnace for space heating and an integral DX cooling section for space cooling. Combustion air intake, exhaust, and condenser airflow are routed through the building exterior.",
                  "The Magic-Pak unit operates as a self-contained heating and cooling system serving the individual suite and is controlled by a local in-suite thermostat. Supply air is delivered directly to the suite through internal ductwork, with return air drawn from the suite space.",
                  "While this configuration provides decentralized heating and cooling, Magic-Pak units rely on individual gas combustion appliances and conventional DX cooling, which are generally less efficient than modern heat pump\u2013based systems. Over the long term, this results in higher maintenance and inspection requirements, variable performance between suites, and limited opportunities for centralized control, energy optimization, or emissions reduction."
                ]
              },
              "role": "equipment_detail",
              "priority": 100
            },
            {
              "rule_id": "cooling_wshp_intro",
              "if": {
                "all": [
                  {
                    "field": "answers.cooling_system_type",
                    "op": "in",
                    "value": [
                      "wshp_cooling",
                      "fluid_cooler"
                    ]
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Cooling for the building is provided through a water-source heat pump (WSHP) system operating on a low-temperature hydronic loop."
                ]
              },
              "role": "system_header",
              "exclusive_group": "cooling_wshp_header",
              "priority": 20
            },
            {
              "rule_id": "fluid_cooler_heat_rejection",
              "if": {
                "all": [
                  {
                    "field": "answers.fluid_cooler_present",
                    "op": "is_true"
                  },
                  {
                    "field": "answers.cooling_system_type",
                    "op": "in",
                    "value": [
                      "wshp_cooling",
                      "fluid_cooler"
                    ]
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Heat extracted from suites is transferred into the loop and rejected outdoors through a fluid cooler during the cooling season."
                ]
              },
              "role": "equipment_detail"
            },
            {
              "rule_id": "fluid_cooler_seasonal_shutdown",
              "if": {
                "all": [
                  {
                    "field": "answers.site_visit_season",
                    "op": "eq",
                    "value": "heating_season"
                  },
                  {
                    "field": "answers.cooling_system_type",
                    "op": "in",
                    "value": [
                      "wshp_cooling",
                      "fluid_cooler"
                    ]
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "At the time of the site visit, the fluid cooler was seasonally shut down, which is typical for this type of system."
                ]
              },
              "role": "performance"
            },
            {
              "rule_id": "wshp_install_year",
              "if": {
                "all": [
                  {
                    "field": "answers.wshp_install_year",
                    "op": "exists"
                  },
                  {
                    "field": "answers.cooling_system_type",
                    "op": "in",
                    "value": [
                      "wshp_cooling",
                      "fluid_cooler"
                    ]
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "On-site staff reported that the WSHP system was installed in {wshp_install_year}."
                ]
              },
              "role": "equipment_detail"
            },
            {
              "rule_id": "no_wshp_deficiencies",
              "if": {
                "all": [
                  {
                    "field": "answers.wshp_deficiencies_reported",
                    "op": "is_false"
                  },
                  {
                    "field": "answers.cooling_system_type",
                    "op": "in",
                    "value": [
                      "wshp_cooling",
                      "fluid_cooler"
                    ]
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "No visible leakage or vibration issues were observed during the walkthrough."
                ]
              },
              "role": "condition"
            },
            {
              "rule_id": "wshp_performance_reliable",
              "if": {
                "all": [
                  {
                    "field": "answers.wshp_deficiencies_reported",
                    "op": "is_false"
                  },
                  {
                    "field": "answers.cooling_system_type",
                    "op": "in",
                    "value": [
                      "wshp_cooling",
                      "fluid_cooler"
                    ]
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "No major mechanical deficiencies or performance issues were reported by on-site staff at the time of the site visit."
                ]
              },
              "role": "performance"
            },
            {
              "rule_id": "cooling_system_mechanical_condition",
              "then": {
                "paragraphs": [
                  "The existing cooling system equipment was observed to be in {cooling_system_condition_text} condition."
                ]
              },
              "role": "equipment_detail",
              "priority": 1
            }
          ],
          "target_section": "cooling"
        }
      ]
    },
