{
  "rulesets": [
    {
      "ruleset_version": "1.0",
      "ruleset_name": "CENTRAL HEATING & COOLING RULESET – HYDRONIC BOILER + NO CENTRAL COOLING",
      "blocks": [
        {
          "block_id": "central_cooling_existing",
          "block_ref": "{Central Heating/Cooling Systems block}",
          "target_block": "heating",
          "rules": [
            {
              "rule_id": "no_central_cooling_intro",
              "if": {
                "all": [
                  {
                    "field": "answers.cooling_central_system_present",
                    "op": "is_false"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "The building is not equipped with a centralized cooling system such as a chiller or water-source heat pump."
                ]
              }
            },
            {
              "rule_id": "suite_window_portable_ac",
              "if": {
                "all": [
                  {
                    "field": "answers.suite_cooling_type",
                    "op": "eq",
                    "value": "window_and_portable_ac"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Cooling within individual suites is provided by a combination of window-mounted air conditioners and portable indoor air-conditioning units."
                ]
              }
            },
            {
              "rule_id": "window_ac_efficiency_commentary",
              "if": {
                "all": [
                  {
                    "field": "answers.suite_cooling_type",
                    "op": "eq",
                    "value": "window_and_portable_ac"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "These decentralized cooling devices are generally less efficient than modern centralized or heat-pump-based systems.",
                  "Typical window and portable air-conditioning units operate with relatively low coefficients of performance compared to high-efficiency heat pump systems."
                ]
              }
            },
            {
              "rule_id": "window_ac_envelope_impact",
              "if": {
                "all": [
                  {
                    "field": "answers.window_ac_present",
                    "op": "is_true"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "In addition to reduced cooling efficiency, window-mounted air-conditioning units can negatively impact building envelope performance.",
                  "Improper sealing around window installations may allow uncontrolled air infiltration during the heating season.",
                  "This can increase heat loss, draft complaints, and overall space-heating energy consumption."
                ]
              }
            },
            {
              "rule_id": "future_wshp_option",
              "if": {
                "all": [
                  {
                    "field": "answers.future_cooling_upgrade_considered",
                    "op": "is_true"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Installation of a centralized water-source heat pump (WSHP) system could be considered in the near term."
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "ruleset_version": "1.0",
      "ruleset_name": "CENTRAL HEATING & COOLING RULESET – WSHP LOOP WITH ATMOSPHERIC BOILERS",
      "blocks": [
        {
          "block_id": "central_cooling_existing",
          "block_ref": "{Central Heating/Cooling Systems block}",
          "target_block": "heating",
          "rules": [
            {
              "rule_id": "cooling_wshp_intro",
              "if": {
                "all": [
                  {
                    "field": "answers.cooling_system_type",
                    "op": "eq",
                    "value": "wshp"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Cooling for the building is provided through a water-source heat pump (WSHP) system operating on a low-temperature hydronic loop."
                ]
              }
            },
            {
              "rule_id": "fluid_cooler_heat_rejection",
              "if": {
                "all": [
                  {
                    "field": "answers.fluid_cooler_present",
                    "op": "is_true"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Heat extracted from suites is transferred into the loop and rejected outdoors through a fluid cooler during the cooling season."
                ]
              }
            },
            {
              "rule_id": "fluid_cooler_seasonal_shutdown",
              "if": {
                "all": [
                  {
                    "field": "answers.site_visit_season",
                    "op": "eq",
                    "value": "heating_season"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "At the time of the site visit, the fluid cooler was seasonally shut down, which is typical for this type of system."
                ]
              }
            },
            {
              "rule_id": "wshp_install_year_condition",
              "if": {
                "all": [
                  {
                    "field": "answers.wshp_install_year",
                    "op": "exists"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "On-site staff reported that the WSHP system was installed in {wshp_install_year}.",
                  "The WSHP equipment, fluid cooler, and associated hydronic loop were observed to be in generally good mechanical condition."
                ]
              }
            },
            {
              "rule_id": "no_wshp_deficiencies",
              "if": {
                "all": [
                  {
                    "field": "answers.wshp_deficiencies_reported",
                    "op": "is_false"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "No visible leakage or vibration issues were observed during the walkthrough.",
                  "No major mechanical deficiencies or performance issues were reported by on-site staff at the time of the site visit."
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "ruleset_version": "1.0",
      "ruleset_name": "CENTRAL HEATING & COOLING RULESET – HYDRONIC BOILERS + FAN COIL + CHILLER",
      "blocks": [
        {
          "block_id": "central_cooling_existing",
          "block_ref": "{Central Heating/Cooling Systems block}",
          "target_block": "heating",
          "rules": [
            {
              "rule_id": "cooling_central_chiller_intro",
              "if": {
                "all": [
                  {
                    "field": "answers.cooling_system_type",
                    "op": "eq",
                    "value": "central_chiller"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Cooling is provided by a central water-cooled chiller located in the main mechanical room."
                ]
              }
            },
            {
              "rule_id": "cooling_chiller_year_service_area",
              "if": {
                "all": [
                  {
                    "field": "answers.chiller_install_year",
                    "op": "exists"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "The chiller was manufactured in {chiller_install_year} and is original to the building.",
                  "The chiller serves multiple connected buildings."
                ]
              }
            },
            {
              "rule_id": "cooling_tower_no_vfd",
              "if": {
                "all": [
                  {
                    "field": "answers.cooling_tower_present",
                    "op": "is_true"
                  },
                  {
                    "field": "answers.cooling_tower_vfd_present",
                    "op": "is_false"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Heat rejection is provided via a roof-mounted cooling tower.",
                  "The condenser water system, including the cooling tower fan and condenser water pumps, is not equipped with variable frequency drives (VFDs)."
                ]
              }
            },
            {
              "rule_id": "cooling_distribution_condition_ok",
              "if": {
                "all": [
                  {
                    "field": "answers.chilled_water_distribution_condition",
                    "op": "eq",
                    "value": "serviceable"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "The chilled-water distribution system appears to be functioning normally.",
                  "Supply and return piping, pumps, and control valves were observed to be in serviceable condition."
                ]
              }
            },
            {
              "rule_id": "cooling_fancoil_distribution",
              "if": {
                "all": [
                  {
                    "field": "answers.cooling_distribution",
                    "op": "eq",
                    "value": "fan_coil"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Suite-level cooling is provided by in-suite fan coil units operating under local thermostatic control."
                ]
              }
            },
            {
              "rule_id": "cooling_seasonal_shutdown",
              "if": {
                "all": [
                  {
                    "field": "answers.site_visit_season",
                    "op": "eq",
                    "value": "heating_season"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "At the time of the site visit, the chiller and cooling tower were seasonally shut down.",
                  "This is typical for the time of year."
                ]
              }
            },
            {
              "rule_id": "cooling_reliable_operation",
              "if": {
                "all": [
                  {
                    "field": "answers.cooling_issues_reported",
                    "op": "is_false"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "No major physical deficiencies were identified during the walkthrough.",
                  "Building staff reported generally reliable operation during the most recent cooling season."
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "ruleset_version": "1.0",
      "ruleset_name": "CENTRAL HEATING & COOLING RULESET – NEAR-CONDENSING BOILERS + FAN COIL + CHILLER",
      "blocks": [
        {
          "block_id": "central_cooling_existing",
          "block_ref": "{Central Heating/Cooling Systems block}",
          "target_block": "heating",
          "rules": [
            {
              "rule_id": "cooling_chiller_intro",
              "if": {
                "all": [
                  {
                    "field": "answers.cooling_system_type",
                    "op": "eq",
                    "value": "central_chiller"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Cooling is provided by a central water-cooled chiller located in the main mechanical room."
                ]
              }
            },
            {
              "rule_id": "cooling_chiller_year",
              "if": {
                "all": [
                  {
                    "field": "answers.chiller_install_year",
                    "op": "exists"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "The chiller was installed in {chiller_install_year}."
                ]
              }
            },
            {
              "rule_id": "cooling_condenser_vfd",
              "if": {
                "all": [
                  {
                    "field": "answers.condenser_pump_has_vfd",
                    "op": "is_true"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "The condenser pump is equipped with a variable frequency drive (VFD)."
                ]
              }
            },
            {
              "rule_id": "cooling_tower_vfd",
              "if": {
                "all": [
                  {
                    "field": "answers.cooling_tower_present",
                    "op": "is_true"
                  },
                  {
                    "field": "answers.cooling_tower_has_vfd",
                    "op": "is_true"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Heat is rejected to a cooling tower, which is equipped with variable frequency drives (VFDs)."
                ]
              }
            },
            {
              "rule_id": "cooling_equipment_condition_good",
              "if": {
                "all": [
                  {
                    "field": "answers.cooling_equipment_condition",
                    "op": "eq",
                    "value": "good"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "The chiller and condenser water loop equipment were observed to be in good mechanical condition.",
                  "Overall cooling performance is acceptable.",
                  "Detailed testing should be completed during the cooling season."
                ]
              }
            },
            {
              "rule_id": "cooling_fancoil_distribution",
              "if": {
                "all": [
                  {
                    "field": "answers.cooling_distribution",
                    "op": "eq",
                    "value": "fan_coil"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Suites are cooled by fan coil units controlled locally by in-suite thermostats.",
                  "These fan coils use chilled water from the central plant to provide space cooling."
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
