                    "value": "chiller_water"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Cooling is provided by a central water-cooled chiller served by a condenser water loop."
                ]
              },
              "role": "system_header",
              "exclusive_group": "cooling_chiller_water_header",
              "priority": 40
            },
            {
              "rule_id": "cooling_chiller_year",
              "if": {
                "all": [
                  {
                    "field": "answers.chiller_install_year",
                    "op": "exists"
                  },
                  {
                    "field": "answers.cooling_system_type",
                    "op": "eq",
                    "value": "chiller_water"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "The chiller was installed in {chiller_install_year}."
                ]
              },
              "role": "equipment_detail"
            },
            {
              "rule_id": "cooling_condenser_vfd",
              "if": {
                "all": [
                  {
                    "field": "answers.condenser_pump_has_vfd",
                    "op": "is_true"
                  },
                  {
                    "field": "answers.cooling_system_type",
                    "op": "eq",
                    "value": "chiller_water"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "The condenser pump is equipped with a variable frequency drive (VFD)."
                ]
              },
              "role": "equipment_detail"
            },
            {
              "rule_id": "cooling_tower_vfd",
              "if": {
                "all": [
                  {
                    "field": "answers.cooling_tower_present",
                    "op": "is_true"
                  },
                  {
                    "field": "answers.cooling_tower_has_vfd",
                    "op": "is_true"
                  },
                  {
                    "field": "answers.cooling_system_type",
                    "op": "eq",
                    "value": "chiller_water"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Heat is rejected to a cooling tower, which is equipped with variable frequency drives (VFDs)."
                ]
              },
              "role": "equipment_detail"
            },
            {
              "rule_id": "cooling_equipment_condition_good",
              "if": {
                "all": [
                  {
                    "field": "answers.cooling_equipment_condition",
                    "op": "eq",
                    "value": "good"
                  },
                  {
                    "field": "answers.cooling_system_type",
                    "op": "eq",
                    "value": "chiller_water"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "The chiller and condenser water loop equipment were observed to be in good mechanical condition."
                ]
              },
              "role": "condition"
            },
            {
              "rule_id": "cooling_equipment_performance_ok",
              "if": {
                "all": [
                  {
                    "field": "answers.cooling_equipment_condition",
                    "op": "eq",
                    "value": "good"
                  },
                  {
                    "field": "answers.cooling_system_type",
                    "op": "eq",
                    "value": "chiller_water"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Overall cooling performance is acceptable."
                ]
              },
              "role": "performance"
            },
            {
              "rule_id": "cooling_equipment_testing_recommendation",
              "if": {
                "all": [
                  {
                    "field": "answers.cooling_equipment_condition",
                    "op": "eq",
                    "value": "good"
                  },
                  {
                    "field": "answers.cooling_system_type",
                    "op": "eq",
                    "value": "chiller_water"
                  }
                ]
              },
              "then": {
                "paragraphs": [
                  "Detailed testing should be completed during the cooling season."
                ]
              },
              "role": "finding"
            }
          ],
          "target_section": "cooling"
        }
      ]
    },
